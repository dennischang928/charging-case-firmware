/dts-v1/;
#include <st/g0/stm32g030X6.dtsi>
#include <st/g0/stm32g030f6px-pinctrl.dtsi>
#include <zephyr/dt-bindings/led/led.h>  

/ {
	model = "Charging Case";
	compatible = "dennischang,chg-case";

	chosen {
		zephyr,console = &usart2;
		zephyr,shell-uart = &usart2;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	zephyr,user{
		lid-hall-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>; // PIN 7, LID_HALL_N (0V = closed)
		dev-sense-gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>; // PIN 8, DEV_SENSE_N (0V = device present)
		usb-flt-gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>; // PIN 9, USB_FLT_N (0V = fault)
		chg-en-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>; // PIN 15, EFUSE_CHG_EN (0V = disabled)
		chg-flt-gpios = <&gpiob 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // PIN 20, EFUSE_CHG_FLT (0V = fault)
	};
};

&clk_hsi {
	status = "okay";
};

&clk_lse {
	status = "okay";
};

&pll {
	div-m = <1>;
	mul-n = <8>;
	div-r = <2>;
	clocks = <&clk_hsi>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(64)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
};

/* 
&usart1 {
	pinctrl-0 = <&usart1_tx_pb6 &usart1_rx_pb7>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};
*/

&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* 

&i2c2 {
	pinctrl-0 = <&i2c2_scl_pa11 &i2c2_sda_pa12>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";
};
*/

&spi1 {
	pinctrl-0 = <&spi1_sck_pa1 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	status = "okay";

	led_strip: ws2812b@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		spi-max-frequency = <4000000>;
		/* frame-format = <32768>; */
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		chain-length = <4>;                 // D1–D4
		color-mapping = <LED_COLOR_ID_GREEN // WS2812B expects colors in G, R, B order
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
	};
};
